require "base64"
require "shellwords"
require "tmpdir"

default_platform(:ios)

PROJECT = "JPKILocalSignerApp.xcodeproj"
SCHEME = "JPKILocalSignerApp"
APP_IDENTIFIER = "biz.geekproject.JPKILocalSignerApp"

# Materialize the base64-encoded App Store Connect .p8 API key secret to a file
# and build an api_key hash. xcodebuild needs the .p8 path for cloud signing;
# app_store_connect_api_key needs it for uploads. Shared by :beta, :release, and
# :upload_metadata so the three lanes authenticate identically.
def materialize_asc_api_key
  key_id = ENV.fetch("ASC_KEY_ID")
  issuer_id = ENV.fetch("ASC_ISSUER_ID")
  key_path = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
  File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8")))
  api_key = app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_path
  )
  { api_key: api_key, key_path: key_path, key_id: key_id, issuer_id: issuer_id }
end

# Lane options passed on the CLI (e.g. `fastlane release submit:false`) arrive as
# strings, and the string "false" is truthy in Ruby — coerce explicitly.
def to_bool(value, default = false)
  return default if value.nil?
  return value if value == true || value == false
  %w[true 1 yes y].include?(value.to_s.strip.downcase)
end

platform :ios do
  # gym/xcodebuild need a full Xcode. On machines whose `xcode-select` points
  # at the Command Line Tools, aim DEVELOPER_DIR at Xcode so `fastlane beta`
  # works without a wrapper. Skipped in CI (setup-xcode selects a real Xcode,
  # so xcode-select never reports CommandLineTools) and when already set.
  before_all do
    if ENV["DEVELOPER_DIR"].nil? && `xcode-select -p`.include?("CommandLineTools")
      xcode = "/Applications/Xcode.app/Contents/Developer"
      ENV["DEVELOPER_DIR"] = xcode if File.directory?(xcode)
    end

    # Xcode's IPA packaging (IDEDistributionCreateIPAStep) shells out to bare
    # `rsync`. A Homebrew rsync (3.4.x) on PATH rejects Xcode's arguments and
    # fails the export with "Copy failed", so put the system rsync at /usr/bin
    # first. No-op in CI, where /usr/bin/rsync is already the one on PATH.
    if File.exist?("/opt/homebrew/bin/rsync") || File.exist?("/usr/local/bin/rsync")
      ENV["PATH"] = "/usr/bin:#{ENV['PATH']}"
    end
  end

  desc "Build a Release archive and upload it to TestFlight"
  lane :beta do
    asc = materialize_asc_api_key

    # CI signing: import the existing Apple Distribution cert from a base64 .p12
    # secret into a temporary keychain so cloud signing REUSES it instead of
    # minting a new distribution certificate every run (Apple caps those at ~2).
    # Only runs in CI where the secret is set; locally the login keychain's cert
    # is used unchanged.
    if ENV["DIST_CERT_P12"] && !ENV["DIST_CERT_P12"].empty?
      setup_ci
      cert_path = File.join(Dir.tmpdir, "dist_cert.p12")
      File.write(cert_path, Base64.decode64(ENV.fetch("DIST_CERT_P12")))
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV["DIST_CERT_PASSWORD"].to_s,
        keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain",
        keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"].to_s
      )
    end

    # TestFlight requires a build number strictly higher than any already
    # uploaded for this version. A 10-digit yyMMddHHmm timestamp is monotonic
    # and stays under the per-field CFBundleVersion limit (2^32-1). Used for
    # both local and CI runs so the two schemes never collide (GITHUB_RUN_NUMBER
    # would be a small integer, lower than an existing timestamp, and rejected).
    build_number = Time.now.strftime("%y%m%d%H%M")

    # Print the build number so `fastlane release build_number:<n>` can promote
    # THIS exact build to the App Store instead of rebuilding it.
    UI.important("TestFlight build number: #{build_number}")

    # Cloud signing: -allowProvisioningUpdates plus the API key let xcodebuild
    # create/use the Apple Distribution cert and App Store profile with no certs
    # checked into the repo. The auth key MUST reach both the archive and the
    # export step (gym forwards xcargs to each) — without it, export fails with
    # "no provisioning profile mapping". The key needs the App Manager role.
    #
    # CURRENT_PROJECT_VERSION is injected as a build setting (not agvtool) so the
    # project needs no Apple Generic Versioning and the pbxproj is never mutated;
    # GENERATE_INFOPLIST_FILE = YES copies it into CFBundleVersion.
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{asc[:key_path].shellescape}",
        "-authenticationKeyID #{asc[:key_id]}",
        "-authenticationKeyIssuerID #{asc[:issuer_id]}",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" "),
      export_options: { signingStyle: "automatic" },
      output_directory: "build" # keep the .ipa/.dSYM out of the repo root
    )

    upload_to_testflight(
      api_key: asc[:api_key],
      skip_waiting_for_build_processing: true
    )
  end

  desc "Push App Store listing metadata only (no binary, no screenshots, no review submission)"
  # Safe, idempotent metadata-only sync from fastlane/metadata. Use this to
  # iterate on the store description/keywords/URLs without touching the binary
  # or submitting for review. Does NOT run precheck.
  lane :upload_metadata do
    upload_to_app_store(
      api_key: materialize_asc_api_key[:api_key],
      app_identifier: APP_IDENTIFIER,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      run_precheck_before_submit: false,
      force: true # no interactive HTML preview (CI-safe)
    )
  end

  desc "Promote an already-uploaded TestFlight build to the App Store: sync metadata + screenshots and submit for review"
  # Reuses the binary already validated on TestFlight (skip_binary_upload) rather
  # than rebuilding, so the App Store build is bit-identical to the beta build.
  #
  #   fastlane release build_number:<yyMMddHHmm printed by the beta lane>
  #
  # Pass with_screenshots:true once fastlane/screenshots is populated (default
  # skips them so a text-only first pass isn't blocked on screenshot capture).
  # Set submit:false to sync metadata without submitting for review (dry run).
  lane :release do |opts|
    with_screenshots = to_bool(opts[:with_screenshots], false)
    submit = to_bool(opts[:submit], true)

    # Treat a blank build_number (e.g. an empty workflow_dispatch input) as unset
    # so deliver falls back to the latest processed build.
    build_number = opts[:build_number].to_s.strip
    build_number = nil if build_number.empty?

    upload_to_app_store(
      api_key: materialize_asc_api_key[:api_key],
      app_identifier: APP_IDENTIFIER,

      # Reuse the build already processed via `fastlane beta`; do not rebuild.
      # Omit build_number to let deliver pick the latest processed build.
      skip_binary_upload: true,
      build_number: build_number,

      # Metadata + (optionally) screenshots from fastlane/metadata and
      # fastlane/screenshots.
      skip_metadata: false,
      skip_screenshots: !with_screenshots,
      overwrite_screenshots: with_screenshots,

      # Review submission.
      submit_for_review: submit,
      automatic_release: false, # press "Release this version" manually after approval
      phased_release: true, # 7-day staged rollout for updates
      force: true, # skip the HTML preview (no TTY in CI)
      precheck_include_in_app_purchases: false, # no IAP
      run_precheck_before_submit: true,

      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false, # exempt digital-signature use
        export_compliance_encryption_updated: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
